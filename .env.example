# Required for durable encrypted local data. Generate with: openssl rand -base64 32
DATA_ENCRYPTION_KEY=
# Optional: enables Google OAuth. Configure this exact redirect URI in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# Optional: Anthropic companion connection. Without it, Daily Life uses a warm local demo reply.
# Create the key in Anthropic Console; never expose it in the browser.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_BASE=claude-haiku-4-5
ANTHROPIC_MODEL_PRO=claude-sonnet-4-5
ANTHROPIC_MODEL_ULTRA=claude-opus-4-5
PORT=3000
